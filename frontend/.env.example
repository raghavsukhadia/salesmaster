# Copy to frontend/.env.local if you need to override locally. Never put secrets in VITE_ variables:
# they are embedded in the public JavaScript bundle.

# Backend origin. Leave empty for local development (Vite proxies /api to the Django dev server).
# On Vercel set it to the Cloud Run URL, e.g. https://sales-master-api-xxxxx.asia-south1.run.app
# (no trailing slash, no /api). Vite reads it at build time, so redeploy after changing it.
VITE_API_URL=
