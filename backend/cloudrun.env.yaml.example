# Copy to cloudrun.env.yaml and replace placeholders. No passwords belong in this file:
# DJANGO_SECRET_KEY and DB_PASSWORD come from Secret Manager (--set-secrets).
DEBUG: "false"
ALLOWED_HOSTS: ".run.app"
FRONTEND_URLS: "https://YOUR-VERCEL-PROJECT.vercel.app"
INSTANCE_CONNECTION_NAME: "YOUR-PROJECT:asia-south1:sales-master-db"
DB_NAME: "sales_master"
DB_USER: "sales_master"
GS_BUCKET_NAME: "YOUR-PROJECT-sunkool-private"
VISIT_MIN_PHOTOS: "0"
