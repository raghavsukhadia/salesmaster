# Copy to cloudrun.env.yaml and replace placeholders. No passwords belong in this file.
DJANGO_DEBUG: "false"
DJANGO_ALLOWED_HOSTS: ".run.app"
CORS_ALLOWED_ORIGINS: "https://YOUR-VERCEL-PROJECT.vercel.app"
CSRF_TRUSTED_ORIGINS: "https://YOUR-VERCEL-PROJECT.vercel.app"
DATABASE_NAME: "sales_master"
DATABASE_USER: "sales_master"
DATABASE_HOST: "/cloudsql/YOUR-PROJECT:asia-south1:sales-master-db"
DATABASE_PORT: "5432"
GS_BUCKET_NAME: "YOUR-PROJECT-sunkool-private"
VISIT_MIN_PHOTOS: "0"
