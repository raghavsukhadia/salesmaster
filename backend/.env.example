# Copy to backend/.env for local development. Never commit real values.
# (Older names DJANGO_DEBUG, DJANGO_ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS are still accepted as fallbacks.)

DJANGO_SECRET_KEY=
# true locally; leave unset/false in production. Without DEBUG=true, DJANGO_SECRET_KEY is required.
DEBUG=true
# Comma-separated hostnames. Cloud Run example: sales-master-api-xxxxx.asia-south1.run.app
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated frontend origins (used for CORS and CSRF). Vercel example: https://your-app.vercel.app
FRONTEND_URLS=http://localhost:5173

# --- Cloud SQL (production) ---
# When INSTANCE_CONNECTION_NAME is set, Django connects to PostgreSQL via /cloudsql/<INSTANCE_CONNECTION_NAME>.
# Format: PROJECT_ID:asia-south1:INSTANCE_NAME
INSTANCE_CONNECTION_NAME=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Private bucket for visit photos (required on Cloud Run only).
GS_BUCKET_NAME=

# --- Optional local PostgreSQL (ignored when INSTANCE_CONNECTION_NAME is set) ---
# Leave DATABASE_NAME empty to use SQLite locally.
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=
DATABASE_PORT=

# Number of car photos required per visit (0 = optional).
VISIT_MIN_PHOTOS=0
